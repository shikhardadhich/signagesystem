rules_version = '2';

// The submission queue is only ever touched by the Cloud Function via the
// Admin SDK, which bypasses these rules. Denying direct client access keeps
// the moderation state from being readable or writable from a browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
